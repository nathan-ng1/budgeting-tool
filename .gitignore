#Environments
env/
.env
# Real transaction data — never commit actual financial data
.data/
config/

# Safety net for installs that accepted setup's old suggested DATABASE_PATH
# (repo root, before it was fixed to suggest .data/budget.db) - real
# financial data, and untracked, so it shouldn't block update.bat either
/budget.db*

# Installation Pack update-check throttle state (issue #116, ADR-0019)
.setup/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Dashboard frontend — node deps and the `npm run build` output, both rebuilt
# from frontend/ rather than committed
node_modules/
src/dashboard/static/

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Written by `python -m dashboard.build_info` for a compiled build (spec #236, S3)
src/dashboard/build_info.json

# Output of `python -m retail_build build` (Issue #252)
/retail-build/
