# Copy this file to .env and fill in your own values.
# .env is gitignored — real values here never get committed.

# Absolute path to the folder outside this repo where you download raw
# Statement Exports before running `uv run python -m sanitising`.
TRANSACTIONS_INBOX=D:\Users\you\Documents\Transactions

# Path to the local SQLite database file — the live store for the
# Transaction Log and Recurring Transactions Config (see ADR-0005). Created
# automatically on first run if it doesn't already exist.
DATABASE_PATH=D:\Users\you\Documents\Transactions\budget.db

# Optional — only needed if you process Beem Reports. Which side of each row
# (Payer/Recipient) is you, so a signed amount can be derived.
BEEM_USERNAME=

CATEGORISER_BACKEND=claude
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
